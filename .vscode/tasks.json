{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure windows-debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "windows-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build windows-debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "windows-debug",
                "--target",
                "go-app"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: configure windows-debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
